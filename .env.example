DATABASE_URL=
GROUP_VERIFICATION_CODE=
SUPABASE_URL=
SUPABASE_KEY=
SECRET_KEY=
SUPABASE_ANON_KEY=
CLUB_NAME=
GITHUB_REPO=
GITHUB_TOKEN=

# AI模型配置
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
AI_MODEL=deepseek-ai/DeepSeek-V3
AI_CACHE_ENABLED=true
AI_CACHE_TTL=3600
AI_TIMEOUT=20
AI_CACHE_MAX_ENTRIES=500

# AI 虚拟好友（只用免费模型；失败自动回落 FAQ，不会调用付费模型）
# 模型池：逗号分隔，按优先级尝试，全部失败则按站内常见问题回答
AI_CHAT_ENABLED=true
AI_CHAT_MODELS=tencent/Hunyuan-MT-7B,XingChenAGI/Xing4.0-29B
AI_CHAT_TIMEOUT=28
AI_CHAT_MAX_TRIES=2
AI_CHAT_COOLDOWN_429=60
AI_CHAT_COOLDOWN_ERROR=30
AI_CHAT_DAILY_LIMIT=30

# SMTP 邮件配置(用于发送验证码和重置链接以及通知)
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USE_SSL=true
MAIL_USERNAME=
MAIL_PASSWORD=

# 可选配置
# SITE_URL：站点公网地址，用于通知里的绝对链接；不配置则退化为当前请求的域名
SITE_URL=
# ALIBABA_CLOUD_ACCESS_KEY_ID / ALIBABA_CLOUD_ACCESS_KEY_SECRET：阿里云 AccessKey，用于新闻正文机器翻译（不配置则新闻不翻译）
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# 上传体积上限（字节），默认 4MB
MAX_CONTENT_LENGTH=4194304

# 应用版本号，未设置时代码回退为 dev
APP_VERSION=dev

# SESSION_COOKIE_SECURE：会话 Cookie 的 Secure 标志，默认跟随部署平台（Vercel 为 1，本地为 0），可显式覆盖
# SESSION_COOKIE_SECURE=1

# 以下由部署平台(Vercel)自动注入，通常无需手动设置：
# VERCEL=1
# VERCEL_GIT_COMMIT_SHA=
