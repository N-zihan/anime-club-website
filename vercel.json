{
  "version": 2,
  "regions": [
    "hkg1"
  ],
  "builds": [
    {
      "src": "run.py",
      "use": "@vercel/python",
      "config": {
        "pythonVersion": "3.14",
        "maxDuration": 60,
        "installCommand": "pip install -r requirements.txt"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "run.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 1 * * 1"
    },
    {
      "path": "/api/cron/weekly-digest-resume",
      "schedule": "30 1 * * 1"
    }
  ]
}
